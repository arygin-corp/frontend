  "engines": {
    "node": ">=16",
    "npm": ">=9"
  },
  "bin": {
    "update-service-worker": "./lib/index.js"
  },
  "scripts": {
    "lint": "tslint ./src/**/*.ts -t verbose",
    "start": "ng serve",
    "test": "ng test",
    "e2e": "ng e2e",
    "engineer": "node deploy/deployment-engineer.build.js",
    "engineer:alt": "node deploy/deployment-engineer2.build.js",
    "build:version": "node deploy/deployment-version.build.js",
    "build:time": "node deploy/deployment-time.build.js",
    "prepare": "node -e \"console.log('APP_VERSION = \\'' + process.env.npm_package_version +'\\';')\" > src/version.js",
    "timestamp": "node ./timestamp.build.js",
    "major": "npm version major --no-git-tag-version",
    "minor": "npm version minor --no-git-tag-version",
    "patch": "node build/update-version.js",
    "//": "--- Utility Scripts ---",
    "build:base": "npm run build:time && npm run build:version && npm run engineer && ng build --configuration=$ENV && npm run prepare",
    "build:full": "npm run build:base && npm run hash && npm run update-sw",
    "hash": "ngsw-config dist ngsw-config.json",
    "update-sw": "node ./lib/index.js -p ./package.json -n ./ngsw-config.json -d \"Automated Build for $ENV Environment\"",
    "local": "cross-env ENV=local npm run build:base",
    "dev": "cross-env ENV=dev npm run build:base && dist/edmp-gdx-client-app/browser/",
    "qa": "cross-env ENV=qa npm run build:base && dist/edmp-gdx-client-app/browser/",
    "demo": "cross-env ENV=demo npm run build:base && dist/edmp-gdx-client-app/browser/",
    "stage": "cross-env ENV=stage npm run build:base && dist/edmp-gdx-client-app/browser/",
    "prod": "cross-env ENV=prod npm run build:base && dist/edmp-gdx-client-app/browser/",
    "local:patch": "npm run patch && cross-env ENV=local npm run build:full",
    "dev:patch": "npm run patch && cross-env ENV=dev npm run build:full",
    "qa:patch": "npm run patch && cross-env ENV=qa npm run build:full",
    "demo:patch": "npm run patch && cross-env ENV=demo npm run build:full",
    "stage:patch": "npm run patch && cross-env ENV=stage npm run build:full",
    "prod:patch": "npm run patch && cross-env ENV=prod npm run build:full && dist/edmp-gdx-client-app/browser/",
    "deploy:demo": "npm run dev && dist/edmp-gdx-client-app/browser/",
    "deploy:dev": "npm run dev && dist/edmp-gdx-client-app/browser/",
    "deploy:qa": "npm run dev && dist/edmp-gdx-client-app/browser/",
    "deploy:stage": "npm run dev && dist/edmp-gdx-client-app/browser/",
    "deploy:prod": "npm run dev && dist/edmp-gdx-client-app/browser/",
    "gzip": "gzipper c ./dist",
    "sprite": "svg-sprite --config src/sprite-config.json src/svg/*.svg",
    "server": "http-server -a localhost -p 8000 -c-1 ./dist"
  },
  "private": true,
